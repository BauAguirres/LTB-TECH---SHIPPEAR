# SneakAR · Variables de entorno (copiá este archivo a .env.local y completá los valores).
# En Vercel/v0 las agrega automáticamente la integración de Supabase.

# URL del proyecto Supabase (pública).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon/publishable (pública). Toda la seguridad depende de RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo desarrollo en v0: redirección de los emails de confirmación al preview.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# La service role key NO se usa en esta fase. Si se usa en el futuro, jamás con prefijo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
